        "args": [
          "acp"
        ]
      },
      "linux-aarch64": {
        "archive": "https://github.com/demkada/argy-code/releases/download/v1.3.6/argy-linux-arm64.tar.gz",
        "cmd": "./argy",
        "args": [
          "acp"
        ]
      },
      "linux-x86_64": {
        "archive": "https://github.com/demkada/argy-code/releases/download/v1.3.6/argy-linux-x64.tar.gz",
        "cmd": "./argy",
        "args": [
          "acp"
        ]
      },
      "windows-x86_64": {
        "archive": "https://github.com/demkada/argy-code/releases/download/v1.3.6/argy-windows-x64.zip",
        "cmd": "argy.exe",
        "args": [
